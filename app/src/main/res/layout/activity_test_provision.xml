<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Info card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1e1e1e"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Device Details"
                        android:textColor="#ffbb00"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <!-- Device ID row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Device Name"
                            android:textColor="#888"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_device_id"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="end"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- MAC Address row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MAC Address"
                            android:textColor="#888"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_mac_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="end"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Relation Device row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="User Device"
                            android:textColor="#888"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_relation_device_id"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="end"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Unicast Address row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Unicast Address"
                            android:textColor="#888"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_unicast_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="end"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Element ID row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Element ID"
                            android:textColor="#888"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_element_id"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="end"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Recive ID row  -->
                    <LinearLayout
                        android:id="@+id/row_recive_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Recive ID"
                            android:textColor="#888"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_recive_id"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="end"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- MQTT Topic row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mqtt Topic"
                            android:textColor="#888"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_mqtttopic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="end"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Status row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Status"
                            android:textColor="#888"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="end"
                            android:hint="Provision"
                            android:textColor="#ffbb00"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Operations card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_operations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1e1e1e"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:letterSpacing="0.08"
                        android:text="Operations"
                        android:textColor="#ffbb00"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Address Input — FIXED: removed android:background="@color/white" -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_address"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Enter Address"
                        app:boxStrokeColor="#ffbb00"
                        app:hintTextColor="#ffbb00">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Address (1–8)"                            android:textColor="@android:color/white"
                            android:textColorHint="#888" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_address"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:text="Save Address"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#333333"
                        app:cornerRadius="8dp"
                        app:strokeColor="#ffbb00"
                        app:strokeWidth="1dp" />

                    <!-- BLE Brightness -->
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="BLE Brightness Control"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/slider_brightness_track" />

                            <View
                                android:id="@+id/bleBrightnessFill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/slider_brightness_fill" />

                            <SeekBar
                                android:id="@+id/bleBrightnessSeek"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="100"
                                android:progressDrawable="@android:color/transparent"
                                android:thumb="@drawable/transparent_thumb"
                                android:thumbOffset="0dp"
                                android:background="@android:color/transparent"
                                android:splitTrack="false"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp" />

                            <ImageButton
                                android:id="@+id/bleDecrement"
                                android:layout_width="56dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:src="@drawable/ic_chevron_left"
                                android:background="@drawable/bg_slider_btn_ripple"
                                android:contentDescription="Decrease"
                                app:tint="#FFFFFF"
                                android:padding="6dp" />

                            <ImageButton
                                android:id="@+id/bleIncrement"
                                android:layout_width="56dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:src="@drawable/ic_chevron_right"
                                android:background="@drawable/bg_slider_btn_ripple"
                                android:contentDescription="Increase"
                                app:tint="#FFFFFF"
                                android:padding="6dp" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/bleBrightnessLabel"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="100%"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:gravity="start" />
                    </LinearLayout>

                    <!-- MQTT Brightness -->
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="MQTT Brightness Control"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/slider_brightness_track" />

                            <View
                                android:id="@+id/mqttBrightnessFill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/slider_brightness_fill" />

                            <SeekBar
                                android:id="@+id/mqttBrightnessSeek"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="100"
                                android:progressDrawable="@android:color/transparent"
                                android:thumb="@drawable/transparent_thumb"
                                android:thumbOffset="0dp"
                                android:background="@android:color/transparent"
                                android:splitTrack="false"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp" />

                            <ImageButton
                                android:id="@+id/mqttDecrement"
                                android:layout_width="56dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:src="@drawable/ic_chevron_left"
                                android:background="@drawable/bg_slider_btn_ripple"
                                android:contentDescription="Decrease"
                                app:tint="#FFFFFF"
                                android:padding="6dp" />

                            <ImageButton
                                android:id="@+id/mqttIncrement"
                                android:layout_width="56dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:src="@drawable/ic_chevron_right"
                                android:background="@drawable/bg_slider_btn_ripple"
                                android:contentDescription="Increase"
                                app:tint="#FFFFFF"
                                android:padding="6dp" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/mqttBrightnessLabel"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="100%"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:gravity="start" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>