<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:background="#1A1A1A"
    android:paddingTop="16dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Tunable White switch chip — top right aligned -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/chipSwitchTunable"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Tunable White →"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:background="#2C2C2C"
            android:elevation="2dp" />

    </LinearLayout>

    <!-- Color Wheel -->
    <no.nordicsemi.android.swaromapmesh.ColorWheelView
        android:id="@+id/colorWheelView"
        android:layout_width="220dp"
        android:layout_height="220dp" />

    <!-- Brightness Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="10dp"
        android:text="Brightness"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Brightness Slider Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/slider_brightness_track" />

            <View
                android:id="@+id/brightnessFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/slider_brightness_fill" />

            <SeekBar
                android:id="@+id/brightnessSeek"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="60"
                android:progressDrawable="@android:color/transparent"
                android:thumb="@android:color/transparent"
                android:background="@android:color/transparent"
                android:splitTrack="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <View
                android:id="@+id/brightnessThumb"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/slider_thumb_inner_yellow"
                android:elevation="4dp" />

        </FrameLayout>

        <TextView
            android:id="@+id/brightnessLabel"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="60%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="start"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Saturation Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="10dp"
        android:text="Saturation"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Saturation Slider Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/slider_brightness_track" />

            <View
                android:id="@+id/saturationFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/slider_saturation_fill" />

            <SeekBar
                android:id="@+id/saturationSeek"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@android:color/transparent"
                android:thumb="@android:color/transparent"
                android:background="@android:color/transparent"
                android:splitTrack="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <View
                android:id="@+id/saturationThumb"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:elevation="4dp" />

        </FrameLayout>

        <TextView
            android:id="@+id/saturationLabel"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="start"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</LinearLayout>