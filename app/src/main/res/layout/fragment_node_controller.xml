                    android:paddingEnd="0dp" />

                <ImageButton
                    android:id="@+id/decrement1"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:src="@drawable/ic_chevron_left"
                    android:background="@drawable/bg_slider_btn_ripple"
                    android:contentDescription="Decrease"
                    app:tint="#FFFFFF"
                    android:padding="6dp" />

                <ImageButton
                    android:id="@+id/increment1"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:src="@drawable/ic_chevron_right"
                    android:background="@drawable/bg_slider_btn_ripple"
                    android:contentDescription="Increase"
                    app:tint="#FFFFFF"
                    android:padding="6dp" />

                <View
                    android:id="@+id/brightnessThumb1"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />
            </FrameLayout>

            <TextView
                android:id="@+id/brightnessLabel1"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="60%"
