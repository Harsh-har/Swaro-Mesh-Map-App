<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1A1A1A"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Color Temperature Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Color Temperature"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Kelvin label -->
    <TextView
        android:id="@+id/kelvinLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:fontFamily="sans-serif" />

    <!-- Color Temperature Slider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp">

        <View
            android:id="@+id/colorTempTrack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/slider_brightness_track" />

        <SeekBar
            android:id="@+id/colorTempSeek"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@android:color/transparent"
            android:thumb="@android:color/transparent"
            android:background="@android:color/transparent"
            android:splitTrack="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <View
            android:id="@+id/colorTempThumb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/slider_thumb_inner_yellow"
            android:elevation="4dp" />

    </FrameLayout>

    <!-- Warm / Cool labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Warm"
            android:textColor="#FFAA44"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Cool"
            android:textColor="#AAD4FF"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Brightness Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="10dp"
        android:text="Brightness"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Brightness Slider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/slider_brightness_track" />

        <View
            android:id="@+id/tunableBrightnessFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/slider_brightness_fill" />

        <SeekBar
            android:id="@+id/tunableBrightnessSeek"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="60"
            android:progressDrawable="@android:color/transparent"
            android:thumb="@android:color/transparent"
            android:background="@android:color/transparent"
            android:splitTrack="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <View
            android:id="@+id/tunableBrightnessThumb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/slider_thumb_inner_yellow"
            android:elevation="4dp" />

    </FrameLayout>

</LinearLayout>