<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:indeterminateTint="#F2F2F2"
        android:visibility="gone" />

    <!-- PLACEHOLDER -->
    <LinearLayout
        android:id="@+id/svg_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        android:background="@color/black">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.3"
            app:srcCompat="@drawable/ic_add_white"
            android:contentDescription="No map" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No map imported yet"
            android:alpha="0.4"
            android:textSize="16sp"
            android:textColor="@android:color/white" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Settings → Import SVG Map"
            android:alpha="0.3"
            android:textSize="13sp"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- SVG MAP -->
    <ImageView
        android:id="@+id/svg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="matrix"
        android:adjustViewBounds="true"
        android:background="@color/black"
        android:contentDescription="SVG Map" />

    <!-- Add Device Mode UI -->
    <LinearLayout
        android:id="@+id/add_device_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#DD000000"
        android:padding="8dp"
        android:visibility="gone"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_cancel_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_add_instructions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Drag icon to position"
            android:gravity="center"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btn_save_device"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <ImageView
        android:id="@+id/draggable_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:src="@drawable/ic_add_white"
        android:background="#88FF0000"
        android:padding="8dp"
        android:elevation="12dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        app:srcCompat="@drawable/ic_add_white"
        app:tint="@color/black"
        android:visibility="gone"
        app:backgroundTint="#F2F2F2" />

    <!-- AutoSetup overlay — SABSE LAST MEIN TAAKI SAB KE UPAR AAYE -->
    <LinearLayout
        android:id="@+id/auto_setup_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar_setup"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:indeterminateTint="#F2F2F2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Setting up device..."
            android:textColor="#F2F2F2"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>