<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:background="#1A1A1A"
    android:paddingTop="16dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Brightness Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="10dp"
        android:text="Brightness"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Brightness Slider Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Slider Container -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <!-- Track -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/slider_brightness_track" />

            <!-- Fill -->
            <View
                android:id="@+id/dimmerBrightnessFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/slider_brightness_fill" />

            <!-- Invisible SeekBar for interaction -->
            <SeekBar
                android:id="@+id/dimmerBrightnessSeek"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="60"
                android:progressDrawable="@android:color/transparent"
                android:thumb="@android:color/transparent"
                android:background="@android:color/transparent"
                android:splitTrack="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <!-- Decrease Button -->
            <ImageButton
                android:id="@+id/dimmerDecrement"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:src="@drawable/ic_chevron_left"
                android:background="@drawable/bg_slider_btn_ripple"
                android:contentDescription="Decrease"
                app:tint="#FFFFFF"
                android:padding="6dp" />

            <!-- Increase Button -->
            <ImageButton
                android:id="@+id/dimmerIncrement"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:src="@drawable/ic_chevron_right"
                android:background="@drawable/bg_slider_btn_ripple"
                android:contentDescription="Increase"
                app:tint="#FFFFFF"
                android:padding="6dp" />

            <!-- Hidden Thumb View -->
            <View
                android:id="@+id/dimmerBrightnessThumb"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />

        </FrameLayout>

        <!-- Status area -->
        <TextView
            android:id="@+id/dimmerBrightnessLabel"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="60%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="start" />

    </LinearLayout>

</LinearLayout>
