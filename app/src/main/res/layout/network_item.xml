<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nordicRed">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        app:srcCompat="@drawable/ic_delete_white" />

    <FrameLayout
        android:id="@+id/removable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:importantForAccessibility="no"
                android:padding="@dimen/mesh_list_icon_padding"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="@id/configured_node_info_container"
                app:layout_constraintEnd_toStartOf="@id/node_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/node_name"
                app:srcCompat="@drawable/networkmesh" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/node_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_horizontal_margin"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="1"
                android:text="@string/nrf_mesh_node"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/configured_node_info_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="@id/node_name"
                app:layout_constraintStart_toStartOf="@id/node_name"
                app:layout_constraintTop_toBottomOf="@id/node_name">

                <!-- Area Name -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/area_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Area:"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="?android:textColorSecondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/areaName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="—"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/area_title"
                    app:layout_constraintTop_toTopOf="@id/area_title"
                    tools:ignore="HardcodedText" />

                <!-- Address -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/unicast_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address:"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="?android:textColorSecondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/areaName"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/unicast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="0x0001"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/unicast_title"
                    app:layout_constraintTop_toTopOf="@id/unicast_title"
                    tools:ignore="HardcodedText" />

                <!-- MAC Address -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mac_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAC:"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="?android:textColorSecondary"
                    app:layout_constraintStart_toStartOf="@id/area_title"
                    app:layout_constraintTop_toBottomOf="@id/unicast"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/macAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="E7:B4:F3:F4:31:44"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/mac_title"
                    app:layout_constraintTop_toTopOf="@id/mac_title"
                    tools:ignore="HardcodedText" />

                <!-- Element ID -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/element_id_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Element ID:"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="?android:textColorSecondary"
                    app:layout_constraintStart_toStartOf="@id/area_title"
                    app:layout_constraintTop_toBottomOf="@id/macAddress"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/elementId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="—"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/element_id_title"
                    app:layout_constraintTop_toTopOf="@id/element_id_title"
                    tools:ignore="HardcodedText" />

                <!-- Receive ID -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/receive_id_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receive ID:"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="?android:textColorSecondary"
                    app:layout_constraintStart_toStartOf="@id/area_title"
                    app:layout_constraintTop_toBottomOf="@id/elementId"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/receiveId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="—"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/receive_id_title"
                    app:layout_constraintTop_toTopOf="@id/receive_id_title"
                    tools:ignore="HardcodedText" />

                <!-- Company (hidden) -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/company_identifier_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/company"
                    android:visibility="gone"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="?android:textColorSecondary"
                    app:layout_constraintStart_toStartOf="@id/area_title"
                    app:layout_constraintTop_toBottomOf="@id/receiveId" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/company_identifier"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingEnd="@dimen/item_padding_end"
                    android:text="@string/nordic_semiconductor_asa"
                    android:visibility="gone"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/unicast"
                    app:layout_constraintTop_toBottomOf="@id/receiveId"
                    tools:ignore="RtlSymmetry" />

                <!-- Elements -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/elements_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/elements"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="?android:textColorSecondary"
                    app:layout_constraintStart_toStartOf="@id/area_title"
                    app:layout_constraintTop_toBottomOf="@id/company_identifier" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/elements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="@id/unicast"
                    app:layout_constraintTop_toBottomOf="@id/company_identifier"
                    tools:ignore="HardcodedText" />

                <!-- Models -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/models_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/models"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="?android:textColorSecondary"
                    app:layout_constraintStart_toStartOf="@id/area_title"
                    app:layout_constraintTop_toBottomOf="@id/elements" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/models"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="29"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="@id/unicast"
                    app:layout_constraintTop_toBottomOf="@id/elements"
                    tools:ignore="HardcodedText" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</FrameLayout>